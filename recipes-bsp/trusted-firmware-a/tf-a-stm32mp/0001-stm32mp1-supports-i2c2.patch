From 628864a5b4cd81f8f1f2f439ea1cc9a59a27f4aa Mon Sep 17 00:00:00 2001
From: mingzq <north_sea@qq.com>
Date: Mon, 24 Feb 2025 07:29:34 +0000
Subject: [PATCH 1/1] stm32mp1: supports i2c2

---
 fdts/stm32mp157c-odyssey.dts                 | 4 ++++
 plat/st/stm32mp1/stm32mp1_def.h              | 1 +
 plat/st/stm32mp1/stm32mp1_shared_resources.c | 1 +
 3 files changed, 6 insertions(+)

diff --git a/fdts/stm32mp157c-odyssey.dts b/fdts/stm32mp157c-odyssey.dts
index 03800f991..9bc493916 100644
--- a/fdts/stm32mp157c-odyssey.dts
+++ b/fdts/stm32mp157c-odyssey.dts
@@ -38,3 +38,7 @@
 	pinctrl-0 = <&uart4_pins_a>;
 	status = "okay";
 };
+
+&cryp1 {
+	status = "okay";
+};
diff --git a/plat/st/stm32mp1/stm32mp1_def.h b/plat/st/stm32mp1/stm32mp1_def.h
index 4074f27d9..b6378d1b3 100644
--- a/plat/st/stm32mp1/stm32mp1_def.h
+++ b/plat/st/stm32mp1/stm32mp1_def.h
@@ -269,6 +269,7 @@ enum ddr_type {
 #define USART3_BASE			U(0x4000F000)
 #define UART4_BASE			U(0x40010000)
 #define UART5_BASE			U(0x40011000)
+#define I2C2_BASE			U(0x40013000)
 #define USART6_BASE			U(0x44003000)
 #define UART7_BASE			U(0x40018000)
 #define UART8_BASE			U(0x40019000)
diff --git a/plat/st/stm32mp1/stm32mp1_shared_resources.c b/plat/st/stm32mp1/stm32mp1_shared_resources.c
index a0ca697ca..a146e3a25 100644
--- a/plat/st/stm32mp1/stm32mp1_shared_resources.c
+++ b/plat/st/stm32mp1/stm32mp1_shared_resources.c
@@ -284,6 +284,7 @@ static void register_periph_iomem(uintptr_t base, unsigned int state)
 	case UART7_BASE:
 	case UART8_BASE:
 	case IWDG2_BASE:
+	case I2C2_BASE:
 		/* Allow drivers to register some non-secure resources */
 		VERBOSE("IO for non-secure resource 0x%x\n",
 			(unsigned int)base);
-- 
2.43.0

