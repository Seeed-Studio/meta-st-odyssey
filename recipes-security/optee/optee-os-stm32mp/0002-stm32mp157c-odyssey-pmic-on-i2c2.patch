From c1911af838301dbbd840e16ce21c9b61eb32b74c Mon Sep 17 00:00:00 2001
From: mingzq <north_sea@qq.com>
Date: Mon, 24 Feb 2025 07:16:33 +0000
Subject: [PATCH 2/2] stm32mp157c-odyssey: pmic on i2c2

---
 core/arch/arm/dts/stm32mp157c-odyssey.dts      | 10 ++++++----
 core/arch/arm/dts/stm32mp157c-odyssey.dtsi     | 10 ++++++----
 core/arch/arm/plat-stm32mp1/platform_config.h  |  4 +++-
 core/arch/arm/plat-stm32mp1/shared_resources.c |  1 +
 core/drivers/clk/clk-stm32mp15.c               |  9 +++++++++
 5 files changed, 25 insertions(+), 9 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp157c-odyssey.dts b/core/arch/arm/dts/stm32mp157c-odyssey.dts
index f1a12726e..36aed46a5 100644
--- a/core/arch/arm/dts/stm32mp157c-odyssey.dts
+++ b/core/arch/arm/dts/stm32mp157c-odyssey.dts
@@ -13,12 +13,13 @@
 #include "stm32mp157c-odyssey.dtsi"
 
 / {
-	model = "STMicroelectronics STM32MP157C-DK2 Discovery Board";
-	compatible = "st,stm32mp157c-dk2", "st,stm32mp157";
+	model = "Seeed Studio Odyssey-STM32MP157C Board";
+	compatible = "seeed,stm32mp157c-odyssey",
+		     "seeed,stm32mp157c-odyssey-som", "st,stm32mp157";
 
 	aliases {
 		ethernet0 = &ethernet0;
-		serial3 = &usart2;
+		serial0 = &uart4;
 	};
 
 	chosen {
@@ -71,9 +72,10 @@
 	st,decprot = <
 		DECPROT(STM32MP1_ETZPC_USART1_ID, DECPROT_NS_RW, DECPROT_UNLOCK)
 		DECPROT(STM32MP1_ETZPC_SPI6_ID, DECPROT_NS_RW, DECPROT_UNLOCK)
+		DECPROT(STM32MP1_ETZPC_I2C2_ID, DECPROT_NS_RW, DECPROT_UNLOCK)
 		DECPROT(STM32MP1_ETZPC_I2C4_ID, DECPROT_NS_RW, DECPROT_UNLOCK)
 		DECPROT(STM32MP1_ETZPC_I2C6_ID, DECPROT_NS_RW, DECPROT_UNLOCK)
-		DECPROT(STM32MP1_ETZPC_RNG1_ID, DECPROT_S_RW, DECPROT_UNLOCK)
+		DECPROT(STM32MP1_ETZPC_RNG1_ID, DECPROT_NS_RW, DECPROT_UNLOCK)
 		DECPROT(STM32MP1_ETZPC_HASH1_ID, DECPROT_NS_RW, DECPROT_UNLOCK)
 		DECPROT(STM32MP1_ETZPC_CRYP1_ID, DECPROT_NS_RW, DECPROT_UNLOCK)
 		DECPROT(STM32MP1_ETZPC_DDRCTRL_ID, DECPROT_NS_R_S_W, DECPROT_LOCK)
diff --git a/core/arch/arm/dts/stm32mp157c-odyssey.dtsi b/core/arch/arm/dts/stm32mp157c-odyssey.dtsi
index e84dc04e3..805b9e63d 100644
--- a/core/arch/arm/dts/stm32mp157c-odyssey.dtsi
+++ b/core/arch/arm/dts/stm32mp157c-odyssey.dtsi
@@ -171,7 +171,7 @@
 };
 
 &hash1 {
-	status = "disabled";
+	status = "ok";
 };
 
 &i2c1 {
@@ -261,11 +261,11 @@
 	cpu-supply = <&vddcore>;
 };
 
-&i2c4 {
+&i2c2 {
 	compatible = "st,stm32mp15-i2c-non-secure";
 	pinctrl-names = "default", "sleep";
-	pinctrl-0 = <&i2c4_pins_a>;
-	pinctrl-1 = <&i2c4_sleep_pins_a>;
+	pinctrl-0 = <&i2c2_pins_a>;
+	pinctrl-1 = <&i2c2_sleep_pins_a>;
 	i2c-scl-rising-time-ns = <185>;
 	i2c-scl-falling-time-ns = <20>;
 	clock-frequency = <400000>;
@@ -644,10 +644,12 @@
 
 &rng1 {
 	status = "okay";
+	secure-status = "okay";
 };
 
 &rtc {
 	status = "okay";
+	secure-status = "okay";
 };
 
 &sai2 {
diff --git a/core/arch/arm/plat-stm32mp1/platform_config.h b/core/arch/arm/plat-stm32mp1/platform_config.h
index d82f1882e..7fd3ab635 100644
--- a/core/arch/arm/plat-stm32mp1/platform_config.h
+++ b/core/arch/arm/plat-stm32mp1/platform_config.h
@@ -174,7 +174,9 @@
 #define UART6_BASE			0x44003000
 #define UART7_BASE			0x40018000
 #define UART8_BASE			0x40019000
-#define VREFBUF_BASE			0x50025000
+#define VREFBUF_BASE		0x50025000
+
+#define I2C2_BASE			0x40013000
 
 #define ROM_BASE			0
 #define ROM_SIZE			0x20000
diff --git a/core/arch/arm/plat-stm32mp1/shared_resources.c b/core/arch/arm/plat-stm32mp1/shared_resources.c
index a19738ae7..ed808884c 100644
--- a/core/arch/arm/plat-stm32mp1/shared_resources.c
+++ b/core/arch/arm/plat-stm32mp1/shared_resources.c
@@ -198,6 +198,7 @@ static void register_periph_iomem(vaddr_t base, enum shres_state state)
 	case UART8_BASE:
 	/* Fall through */
 #endif
+	case I2C2_BASE:
 	case IWDG2_BASE:
 		/* Allow drivers to register some non-secure resources */
 		DMSG("IO for non-secure resource 0x%lx", base);
diff --git a/core/drivers/clk/clk-stm32mp15.c b/core/drivers/clk/clk-stm32mp15.c
index 6fbc3b24f..d1f813d1b 100644
--- a/core/drivers/clk/clk-stm32mp15.c
+++ b/core/drivers/clk/clk-stm32mp15.c
@@ -114,6 +114,7 @@ enum stm32mp1_parent_id {
  * This enum lists only the parent clocks we are interested in.
  */
 enum stm32mp1_parent_sel {
+	_I2C12_SEL,
 	_STGEN_SEL,
 	_I2C46_SEL,
 	_SPI6_SEL,
@@ -452,6 +453,9 @@ static const struct stm32mp1_clk_gate stm32mp1_clk_gate[] = {
 	_CLK_SC_SELEC(N_S, RCC_MP_APB1ENSETR, 18, UART7_K, _UART78_SEL),
 	_CLK_SC_SELEC(N_S, RCC_MP_APB1ENSETR, 19, UART8_K, _UART78_SEL),
 #endif
+
+	_CLK_SC_SELEC(N_S, RCC_MP_APB1ENSETR, 22, I2C2_K, _I2C12_SEL),
+
 	_CLK_SC_FIXED(N_S, RCC_MP_APB2ENSETR, 2, TIM15_K, _PCLK2),
 #ifdef CFG_WITH_NSEC_UARTS
 	_CLK_SC_SELEC(N_S, RCC_MP_APB2ENSETR, 13, USART6_K, _UART6_SEL),
@@ -471,6 +475,10 @@ const uint8_t stm32mp1_clk_on[] = {
 };
 
 /* Parents for secure aware clocks in the xxxSELR value ordering */
+static const uint8_t i2c12_parents[] = {
+	_PCLK1, _PLL4_R, _HSI_KER, _CSI_KER
+};
+
 static const uint8_t stgen_parents[] = {
 	_HSI_KER, _HSE_KER
 };
@@ -520,6 +528,7 @@ static const uint8_t rtc_parents[] = {
 
 static const struct stm32mp1_clk_sel stm32mp1_clk_sel[_PARENT_SEL_NB] = {
 	/* Secure aware clocks */
+	_CLK_PARENT(_I2C12_SEL, RCC_I2C12CKSELR, 0, 0x7, i2c12_parents),
 	_CLK_PARENT(_STGEN_SEL, RCC_STGENCKSELR, 0, 0x3, stgen_parents),
 	_CLK_PARENT(_I2C46_SEL, RCC_I2C46CKSELR, 0, 0x7, i2c46_parents),
 	_CLK_PARENT(_SPI6_SEL, RCC_SPI6CKSELR, 0, 0x7, spi6_parents),
-- 
2.43.0

